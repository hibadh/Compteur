<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre_compteur"
        android:textSize="24sp"/>

    <TextView
        android:id="@+id/textViewCompteur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/valeur_compteur"
        android:textSize="40sp"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/buttonIncrementer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bouton_plus"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/buttonDecrementer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bouton_moins"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/buttonReinitialiser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bouton_reinitialiser"
        android:layout_marginTop="10dp"/>

</LinearLayout>